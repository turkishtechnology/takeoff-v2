{
  "name": "@takeoff-ui/react-spar",
  "version": "0.0.1",
  "description": "React-first Takeoff wrappers built on top of @turkish-technology/spar.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node ./scripts/build.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pack:check": "npm pack --dry-run --json --cache ../../.npm-cache",
    "prepack": "node ./scripts/build.js"
  },
  "dependencies": {
    "@turkish-technology/spar": "0.1.3"
  },
  "peerDependencies": {
    "@takeoff-design/tokens": ">=0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@takeoff-design/tokens": "link:../../../takeoff-design/packages/tokens",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
