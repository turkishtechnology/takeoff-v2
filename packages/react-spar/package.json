{
  "name": "@takeoff-ui/react-spar",
  "version": "0.1.0",
  "description": "React-first Takeoff wrappers built on top of @turkish-technology/spar.",
  "type": "module",
  "author": "Turkish Technology Frontend Infrastructure Team <takeoffui@thy.com>",
  "homepage": "https://takeoff-v2.app.turkishtechlab.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/turkishtechnology/takeoff-v2.git",
    "directory": "packages/react-spar"
  },
  "keywords": [
    "react",
    "react-components",
    "takeoff",
    "takeoff-ui",
    "spar",
    "headless-ui",
    "design-system",
    "component-library",
    "typescript",
    "accessibility",
    "a11y",
    "react-19"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pack:check": "npm pack --dry-run --json --cache ../../.npm-cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "node ./scripts/generate-component.mjs",
    "lint:spar-pick": "node ./scripts/check-spar-pick.mjs",
    "prepack": "tsup"
  },
  "dependencies": {
    "@turkish-technology/spar": "0.2.0-beta.1",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@takeoff-design/tokens": "0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@takeoff-design/tokens": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
