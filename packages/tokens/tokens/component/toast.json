{
  "component": {
    "toast": {
      "$type": "dimension",
      "toast-base-radius": {
        "$value": "{base.radius.m-base}"
      },
      "toast-base-h-padding": {
        "$value": "{base.spacing.xl}"
      },
      "toast-base-v-padding": {
        "$value": "{base.spacing.xl}"
      },
      "toast-base-gap": {
        "$value": "{base.spacing.m-base}"
      },
      "toast-base-content-gap": {
        "$value": "{base.spacing.m-base}"
      },
      "toast-sign-base-size": {
        "$value": "{base.spacing.5xl}"
      },
      "toast-sign-base-full-padding": {
        "$value": "{base.spacing.s}"
      },
      "toast-sign-large-size": {
        "$value": "{base.spacing.6xl}"
      },
      "toast-sign-large-full-padding": {
        "$value": "{base.spacing.m-base}"
      },
      "toast-sign-small-size": {
        "$value": "{base.spacing.4xl}"
      },
      "toast-sign-small-full-padding": {
        "$value": "{base.spacing.xs}"
      },
      "gradient-info-gradient-tozero": {
        "$value": "linear-gradient(270deg, var(--background-lightest) 89%, var(--states-info-sub-base) 100%)"
      },
      "gradient-success-gradient-tozero": {
        "$value": "linear-gradient(270deg, var(--background-lightest) 89%, var(--states-success-sub-base) 100%)"
      },
      "gradient-danger-gradient-tozero": {
        "$value": "linear-gradient(270deg, var(--background-lightest) 89%, var(--states-danger-sub-base) 100%)"
      },
      "gradient-warning-gradient-tozero": {
        "$value": "linear-gradient(270deg, var(--background-lightest) 89%, var(--states-warning-sub-base) 100%)"
      },
      "gradient-gradient-gray": {
        "$value": "linear-gradient(270deg, var(--background-lightest) 89%, var(--background-sub-base) 100%)"
      }
    }
  }
}
