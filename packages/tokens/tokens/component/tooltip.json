{
  "component": {
    "tooltip": {
      "$type": "dimension",
      "tooltips-base-radius": {
        "$value": "{base.radius.m-base}"
      },
      "tooltips-base-h-padding": {
        "$value": "{base.spacing.xl}"
      },
      "tooltips-base-v-padding": {
        "$value": "{base.spacing.m-base}"
      },
      "tooltips-base-gap": {
