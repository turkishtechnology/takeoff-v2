{
  "name": "@takeoff-design/tailwind",
  "version": "0.0.0",
  "description": "Tailwind CSS theme package for Takeoff Design",
  "author": "Turkish Technology Frontend Infrastructure Team <takeoffui@thy.com>",
  "homepage": "https://takeoffui.com",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "style": "./dist/v4/theme.css",
      "default": "./dist/v4/theme.css"
    },
    "./v4": {
      "style": "./dist/v4/theme.css",
      "default": "./dist/v4/theme.css"
    },
    "./v3": {
      "require": "./dist/v3/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "pack:check": "node ../../tools/check-package-pack.mjs tailwind"
  },
  "dependencies": {
    "@takeoff-design/tokens": "workspace:*"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.0.0"
  },
  "devDependencies": {
    "prettier": "^3.3.1",
    "tailwindcss": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/turkishtechnology/takeoff-design.git",
    "directory": "packages/tailwind"
  },
  "publishConfig": {
    "access": "public"
  }
}
