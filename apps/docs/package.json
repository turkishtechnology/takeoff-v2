{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build:tokens": "pnpm --filter @takeoff-design/tokens build",
    "build:react-spar": "pnpm --filter @takeoff-ui/react-spar build",
    "gen:api": "node scripts/generate-api-mdx.mjs",
    "predev": "pnpm run build:tokens && pnpm run build:react-spar && pnpm run gen:api",
    "dev": "docusaurus start",
    "prebuild": "pnpm run build:tokens && pnpm run build:react-spar && pnpm run gen:api",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@docusaurus/theme-common": "^3.10.1",
    "@hookform/resolvers": "^5.4.0",
    "@takeoff-design/tailwind": "workspace:^",
    "@takeoff-design/tokens": "workspace:*",
    "@takeoff-ui/react-spar": "workspace:*",
    "@tanstack/react-form": "^1.33.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "react-live": "^4.1.8",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@docusaurus/tsconfig": "^3.7.0",
    "@docusaurus/types": "^3.7.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
