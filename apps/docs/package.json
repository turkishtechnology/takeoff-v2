{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build:tokens": "pnpm --filter @takeoff-design/tokens build",
    "build:react-spar": "pnpm --filter @takeoff-ui/react-spar build",
    "build:tailwind": "pnpm --filter @takeoff-design/tailwind build",
    "gen:api": "node scripts/generate-api-mdx.mjs",
    "gen:api:check": "node scripts/check-api-mdx.mjs",
    "gen:icons": "node scripts/generate-icons.mjs",
    "gen:llms": "node scripts/generate-llms.mjs",
    "predev": "pnpm run build:tokens && pnpm run build:react-spar && pnpm run build:tailwind && pnpm run gen:api && pnpm run gen:icons && pnpm run gen:llms",
    "dev": "docusaurus start",
    "prebuild": "pnpm run build:tokens && pnpm run build:react-spar && pnpm run build:tailwind && pnpm run gen:api && pnpm run gen:icons && pnpm run gen:llms",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@hookform/resolvers": "^5.4.0",
    "@takeoff-design/tailwind": "workspace:^",
    "@takeoff-design/tokens": "workspace:*",
    "@takeoff-icons/core": "^0.4.0",
    "@takeoff-icons/react": "^0.4.0",
    "@takeoff-ui/react-spar": "workspace:*",
    "@tanstack/react-form": "^1.33.2",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-live": "^4.1.8",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
