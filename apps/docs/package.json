{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "generate:api": "node ./src/docs-files/generate-mdx.mjs",
    "verify:generated-api": "node ./src/docs-files/generate-mdx.mjs && git diff --exit-code -- ./src/docs-files",
    "build:react-spar": "pnpm --filter @takeoff-ui/react-spar build",
    "predev": "pnpm run generate:api && pnpm run build:react-spar",
    "dev": "docusaurus start",
    "prebuild": "pnpm run generate:api && pnpm run build:react-spar",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@docusaurus/theme-common": "^3.7.0",
    "@takeoff-design/tokens": "link:../../../takeoff-design/packages/tokens",
    "@takeoff-ui/react-spar": "workspace:*",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-live": "^4.1.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@docusaurus/tsconfig": "^3.7.0",
    "@docusaurus/types": "^3.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
