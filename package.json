{
  "name": "takeoff",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:figma": "node tools/figma-token-exporter/server.mjs",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:skills": "node ./tools/check-skill-coverage.mjs",
    "lint:skill-props": "node ./tools/check-skill-props.mjs",
    "gen:agent-instructions": "node ./tools/generate-agent-instructions.mjs",
    "gen:agent-instructions:check": "node ./tools/generate-agent-instructions.mjs --check",
    "check-types": "turbo run check-types",
    "clean": "rm -rf .turbo packages/*/dist packages/*/.turbo packages/*/node_modules/.vite apps/*/build apps/*/.docusaurus apps/*/.turbo apps/*/node_modules/.cache",
    "clean:modules": "rm -rf node_modules packages/*/node_modules apps/*/node_modules",
    "clean:all": "pnpm clean && pnpm clean:modules && rm -f pnpm-lock.yaml",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,css,scss,json,md,mdx,yml,yaml,html}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,css,scss,json,md,mdx,yml,yaml,html}\"",
    "release": "pnpm changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write --cache"
    ],
    "*.{css,scss,json,md,mdx,yaml,yml,html}": "prettier --write --cache"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
